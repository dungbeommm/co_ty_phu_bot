# Copy to .env. Never commit .env.
# Revoke any token previously posted in chat/GitHub via @BotFather.
BOT_TOKEN=REPLACE_WITH_NEW_BOTFATHER_TOKEN
DATABASE_PATH=data/ty_phu.db
LOG_LEVEL=INFO
MIN_PLAYERS=2
MAX_PLAYERS=6
STARTING_CASH=15000000
PASS_GO_SALARY=2000000

# ID topic Telegram được phép chạy game, cách nhau bằng dấu phẩy.
# Để trống = cho phép mọi topic. Lấy ID từ message_thread_id của topic.
ALLOWED_TOPIC_IDS=

# Xoá tin nhắn của người không tham gia trong topic đang có ván.
# Bot phải là admin và có quyền Delete messages.
LOCK_TOPIC_MESSAGES=true
